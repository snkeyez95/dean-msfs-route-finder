{
  "name": "dean-msfs-route-finder",
  "version": "5.8.2",
  "description": "A Better Route Planner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "dist": "electron-builder",
    "release": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.dean.msfs-route-finder",
    "productName": "A Better Route Planner",
    "directories": {
      "output": "C:\\Temp\\abrp-build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "A Better Route Planner"
    },
    "publish": {
      "provider": "github",
      "owner": "snkeyez95",
      "repo": "dean-msfs-route-finder",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
