{
  "name": "dean-msfs-route-finder",
  "version": "6.8.0",
  "description": "A Better Route Planner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "dist": "electron-builder",
    "release": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.dean.msfs-route-finder",
    "productName": "A Better Route Planner",
    "directories": {
      "output": "C:\\Temp\\abrp-build"
    },
    "files": [
      "**/*",
      "!perf/**",
      "!community_routes.json"
    ],
    "asarUnpack": [
      "node_modules/node-simconnect/**",
      "node_modules/core-util-is/**",
      "node_modules/debug/**",
      "node_modules/if-async/**",
      "node_modules/inherits/**",
      "node_modules/ini/**",
      "node_modules/ms/**",
      "node_modules/readable-stream/**",
      "node_modules/regedit/**",
      "node_modules/safe-buffer/**",
      "node_modules/stream-slicer/**",
      "node_modules/string_decoder/**",
      "node_modules/through2/**",
      "node_modules/util-deprecate/**",
      "node_modules/xtend/**"
    ],
    "extraResources": [
      {
        "from": "perf/PresentMon-x64.exe",
        "to": "perf/PresentMon-x64.exe"
      },
      {
        "from": "perf/vendor",
        "to": "perf/vendor"
      },
      {
        "from": "perf/native",
        "to": "perf/native",
        "filter": [ "**/*.js", "report_assets/**", "!_*", "!**/*.py", "!*.bat" ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "A Better Route Planner",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "snkeyez95",
      "repo": "dean-msfs-route-finder",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-simconnect": "^4.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
